# Firebase web app config for the controller client.
# Copy to `.env` and fill in with your own Firebase project's values:
#   Firebase console -> Project settings -> Your apps -> Web app -> SDK setup and configuration
# `.env` is gitignored - never commit real values, this fork is public.
# vite.config.js sets envDir: '..', so this file must live in controller/web-server/.

VITE_PUBLIC_FIREBASE_API_KEY=
VITE_PUBLIC_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_PUBLIC_PROJECT_ID=your-project
VITE_PUBLIC_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_PUBLIC_MESSAGING_SENDER_ID=
VITE_PUBLIC_APP_ID=
VITE_PUBLIC_MEASUREMENT_ID=

# WebSocket signaling server. Leave unset for LAN use and the client falls back
# to ws://<page-host>:8080/ws.
VITE_PUBLIC_SIGNALING_SERVER_URL=

# Endpoint that mints short-lived TURN credentials - see turn-worker/.
# Required for any connection that crosses NAT (i.e. robot and controller on
# different networks). Without it the client is STUN-only and will fail.
# This URL is public by design; the API token stays inside the Worker.
VITE_PUBLIC_ICE_SERVERS_URL=

# Cloudflare TURN key, from: dashboard -> Realtime -> TURN Keys.
# Kept here only as a note to yourself for `wrangler secret put`; the Worker reads
# them from its own secret store, not from this file. Do NOT prefix with VITE_ -
# that would compile the API token into the public JS bundle.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_KEY_API_TOKEN=
